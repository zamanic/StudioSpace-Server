# Copy this file to .env and fill in your own values.

# MongoDB Atlas connection string (studiospace database is created on first write)
MONGODB_URI=
# The spec's env template uses this name too - point both at the same cluster.
BETTER_AUTH_DB_URL=

PORT=8000

# The Next.js client, where Better Auth publishes its public keys at
# /api/auth/jwks. The API verifies every incoming JWT against them.
CLIENT_URL=http://localhost:3000
